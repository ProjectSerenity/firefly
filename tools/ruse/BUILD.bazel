load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/ruse/bazel:rules.bzl", "ruse_standard_library")

go_library(
    name = "ruse_lib",
    srcs = [
        "main.go",
    ],
    importpath = "firefly-os.dev/tools/ruse",
    visibility = ["//visibility:private"],
    deps = [
        "//tools/ruse/cmd/compile",
        "//tools/ruse/cmd/compile-stdlib",
        "//tools/ruse/cmd/debug",
        "//tools/ruse/cmd/disasm",
        "//tools/ruse/cmd/format",
        "//tools/ruse/cmd/link",
        "//tools/ruse/cmd/rpkg",
        "//tools/ruse/cmd/rstd",
        "//tools/ruse/cmd/x86",
    ],
)

go_binary(
    name = "ruse_nostdlib",
    embed = [":ruse_lib"],
    visibility = ["//tools/ruse:__subpackages__"],
)

go_binary(
    name = "ruse",
    srcs = ["stdlib.go"],
    embed = [":ruse_lib"],
    embedsrcs = [":stdlib"],
    pure = "on",
    static = "on",
    visibility = ["//visibility:public"],
    deps = [
        "//tools/ruse/cmd/internal/stdlib",
    ],
)

ruse_standard_library(
    name = "stdlib",
    arch = "x86-64",
    package_path = "stdlib",
    visibility = ["//visibility:public"],
    deps = [
        "//tools/ruse/stdlib/sections",
    ],
)
